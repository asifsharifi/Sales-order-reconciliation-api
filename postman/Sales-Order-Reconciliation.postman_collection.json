{
  "info": {
    "name": "Sales Order Reconciliation API",
    "_postman_id": "c5016e28-00ca-4f78-b53a-demo000001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "Get All Orders",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        }
      }
    },
    {
      "name": "Reconcile Clean Order 1001",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Order passes reconciliation', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.reconciliationStatus).to.eql('PASSED');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/reconciliation/orders/1001",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reconciliation",
            "orders",
            "1001"
          ]
        }
      }
    },
    {
      "name": "Reconcile Total Mismatch 1002",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Reconciliation finds discrepancy', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.reconciliationStatus).to.eql('FAILED');",
              "  pm.expect(json.discrepancies.some(x => x.type === 'ORDER_TOTAL_MISMATCH')).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/reconciliation/orders/1002",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reconciliation",
            "orders",
            "1002"
          ]
        }
      }
    },
    {
      "name": "Reconcile Price Mismatch 1003",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/reconciliation/orders/1003",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reconciliation",
            "orders",
            "1003"
          ]
        }
      }
    },
    {
      "name": "404 Example",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/orders/999999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "999999"
          ]
        }
      }
    },
    {
      "name": "400 Validation Example",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"externalOrderNo\": \"WEB-TEST\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        }
      }
    },
    {
      "name": "409 Duplicate Example",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"externalOrderNo\": \"WEB-1001\",\n  \"customerId\": 1,\n  \"orderTotal\": 1500\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        }
      }
    }
  ]
}